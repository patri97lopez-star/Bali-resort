rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 3. Path Variable Hardening
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Phase 3: Primitive Definition
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isVerifiedUser() { return isSignedIn() && request.auth.token.email_verified == true; }

    // Phase 4: Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'createdAt']) &&
             data.keys().size() <= 4 &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.email.size() <= 256 &&
             data.createdAt == request.time;
    }

    function isValidReservation(data) {
      return data.keys().hasAll(['userId', 'serviceType', 'serviceName', 'status', 'createdAt', 'updatedAt']) &&
             data.keys().size() <= 7 &&
             data.userId == request.auth.uid &&
             data.serviceType in ['restaurante', 'experiencia', 'villa', 'actividad', 'transporte'] &&
             data.serviceName is string &&
             data.serviceName.size() <= 256 &&
             data.status in ['pendiente', 'confirmada', 'cancelada'] &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    // 1. & 6. PII Isolation & Schema Constraints
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email']);
      // No list or delete by default for users to prevent scraping or accidental deletion
    }

    // 8. Secure List Queries (The "Query Enforcer")
    match /reservations/{reservationId} {
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow get: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidReservation(incoming());
      
      allow update: if isOwner(existing().userId) && isValidReservation(incoming()) &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['status', 'details', 'updatedAt']);
                    
      allow delete: if isOwner(existing().userId);
    }
  }
}
